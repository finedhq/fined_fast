{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-static-pages.mjs && node scripts/build-app-update.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "app:test": "vite build --config vite.config.apptest.js --mode apptest && cap sync android && node scripts/android-build.mjs debug",
    "app:android:debug": "node scripts/android-build.mjs debug",
    "app:android:release": "node scripts/android-build.mjs release",
    "check:website": "node scripts/check-website-build.mjs",
    "app:native-bump": "node scripts/app-native-bump.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.19.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/capacitor-updater": "8.53.1",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@sentry/react": "^10.70.0",
    "@tailwindcss/vite": "^4.3.0",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.23",
    "motion": "^14.0.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.17.0",
    "swiper": "^14.0.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fflate": "0.8.3",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.2"
  }
}
