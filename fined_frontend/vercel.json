{
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/articles", "destination": "/articles.html" },
    { "source": "/articles/", "destination": "/articles.html" },
    { "source": "/courses", "destination": "/courses.html" },
    { "source": "/courses/", "destination": "/courses.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/about/", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact/", "destination": "/contact.html" },
    { "source": "/feedback", "destination": "/feedback.html" },
    { "source": "/feedback/", "destination": "/feedback.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/help/", "destination": "/help.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy-policy/", "destination": "/privacy-policy.html" },
    { "source": "/termsofservice", "destination": "/termsofservice.html" },
    { "source": "/termsofservice/", "destination": "/termsofservice.html" },
    { "source": "/tags/personal-finance", "destination": "/tags/personal-finance.html" },
    { "source": "/tags/personal-finance/", "destination": "/tags/personal-finance.html" },
    { "source": "/tags/ipo", "destination": "/tags/ipo.html" },
    { "source": "/tags/ipo/", "destination": "/tags/ipo.html" },
    { "source": "/tags/investing", "destination": "/tags/investing.html" },
    { "source": "/tags/investing/", "destination": "/tags/investing.html" },
    { "source": "/tags/deep-dives", "destination": "/tags/deep-dives.html" },
    { "source": "/tags/deep-dives/", "destination": "/tags/deep-dives.html" },
    { "source": "/tags/economy", "destination": "/tags/economy.html" },
    { "source": "/tags/economy/", "destination": "/tags/economy.html" },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.myfined.com/sitemap.xml"
    },
    {
      "source": "/articles/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|applebot|discordbot|bingbot|googlebot|pinterest|skypeuripreview|gptbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|bytespider|cohere|diffbot|ia_archiver|curl|wget|python-requests|urllib).*"
        }
      ],
      "destination": "https://api.myfined.com/articles/:slug*"
    },
    {
      "source": "/authors/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|applebot|discordbot|bingbot|googlebot|pinterest|skypeuripreview|gptbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|bytespider|cohere|diffbot|ia_archiver|curl|wget|python-requests|urllib).*"
        }
      ],
      "destination": "https://api.myfined.com/authors/:slug*"
    },
    {
      "source": "/certificate/:code*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|applebot|discordbot|bingbot|googlebot|pinterest|skypeuripreview).*"
        }
      ],
      "destination": "https://api.myfined.com/certificate/:code*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
