{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.myfined.com/sitemap.xml"
    },
    {
      "source": "/articles/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|applebot|discordbot|bingbot|googlebot|pinterest|skypeuripreview|gptbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|bytespider|cohere|diffbot|ia_archiver|curl|wget|python-requests|urllib).*"
        }
      ],
      "destination": "https://api.myfined.com/articles/:slug*"
    },
    {
      "source": "/authors/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|applebot|discordbot|bingbot|googlebot|pinterest|skypeuripreview|gptbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|bytespider|cohere|diffbot|ia_archiver|curl|wget|python-requests|urllib).*"
        }
      ],
      "destination": "https://api.myfined.com/authors/:slug*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}